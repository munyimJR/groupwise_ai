# ---- GroupWise AI web app (copy to frontend/.env.local) ----

# Where the FastAPI service runs. The browser calls /api on this site; Next.js proxies it here.
BACKEND_URL=http://127.0.0.1:8000

# Optional: Supabase Auth for real accounts (public anon key only — never the service-role key).
# Leave empty to use GroupWise's built-in accounts. The demo sandbox works either way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: legacy anon key instead
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
