# ---- GroupWise AI API (copy to backend/.env for local development) ----
APP_ENV=development

# Local: SQLite file. Production: Supabase Postgres connection string (Project settings → Database →
# Connection pooling, "Transaction" mode, port 6543), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./groupwise.db

# Comma-separated origins allowed to call the API directly (the Next.js app proxies /api, so this
# mainly matters for tools/docs). Public URL of the web app, used in invite links.
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Signing key for tokens issued by this API (local accounts + demo sandbox).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=72
ALLOW_LOCAL_AUTH=true

# Supabase Auth (optional). With SUPABASE_URL set, Supabase access tokens are verified via the
# project's JWKS; set SUPABASE_JWT_SECRET only for projects that still use the legacy HS256 secret.
# Never put the service-role key here or in the frontend.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Demo sandbox for judges / first-time visitors (each visitor gets a private, expiring copy).
DEMO_ENABLED=true
DEMO_TTL_HOURS=48

# LLM explanation layer (optional — every feature has a deterministic fallback).
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=30

# Mobile-wallet (MFS) integration. The sandbox simulates the wallet's approval screen; no real money moves.
WALLET_SANDBOX_ENABLED=true
# Shared HMAC key for signed events at /api/integrations/wallet/webhook (webhook returns 503 until set).
WALLET_WEBHOOK_SECRET=
WALLET_REQUEST_TTL_MINUTES=30
